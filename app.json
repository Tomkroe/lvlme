{
  "expo": {
    "name": "LvlMe",
    "slug": "lvlme",
    "scheme": "lvlme",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.tomkroe.lvlme",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tomkroe.lvlme"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "LvlMe liest Schlaf, Schritte, aktive Kalorien, Workouts, HRV und Ruhepuls, damit dein Avatar deine Tagesform zeigt. Die Daten bleiben auf deinem iPhone.",
          "NSHealthUpdateUsageDescription": "LvlMe schreibt keine Daten in Apple Health.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
